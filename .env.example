# giscus 댓글 설정 (글 상세 하단 댓글)
# 대상 public repo 에 Discussions 활성화 + giscus 앱 설치 후,
# https://giscus.app 에서 값을 발급받아 .env.local(로컬) 또는 CI 환경변수로 주입한다.
# 세 값이 모두 있어야 댓글이 표시되고, 없으면 안내 플레이스홀더만 노출된다.
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# GitHub Pages 프로젝트 페이지 배포용 basePath (예: /my-blog).
# 유저 페이지(user.github.io)면 비워둔다. CI 빌드시 주입.
BASE_PATH=

# 글 디렉토리 오버라이드 (선택). 미설정 시 기본값 content/posts 사용.
# 평소 dev/build/배포에선 건드릴 필요 없다 — 실제 글은 content/posts 에 둔다.
# E2E는 playwright.config.ts 의 webServer.env 가 이 값을 tests/fixtures/posts 로
# 자동 주입해, 실제 글과 분리된 고정 픽스처로 빌드한다(실제 글 추가가 테스트를 깨지 않음).
# POSTS_DIR=tests/fixtures/posts
