{
  "name": "blog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "search-index": "node scripts/build-search-index.mjs",
    "check:messages": "node scripts/verify-messages.mjs",
    "predev": "npm run check:messages && node scripts/build-search-index.mjs",
    "dev": "next dev",
    "prebuild": "npm run check:messages && node scripts/build-search-index.mjs",
    "build": "next build",
    "postbuild": "node scripts/verify-static-export.mjs",
    "start": "node scripts/serve-out.mjs",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:translations": "playwright test --config playwright.translations.config.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@codesandbox/sandpack-react": "^2.20.0",
    "gray-matter": "^4.0.3",
    "hast-util-to-string": "^3.0.1",
    "next": "16.4.3",
    "photoswipe": "^5.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.4",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.3.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "use-intl": "^4.14.9"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "^3.5.22",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^17.0.8",
    "msw": "^2.15.0",
    "prettier": "^3.9.4",
    "serve": "^14.2.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
